# Spot inspection + control configuration.
#
# Copy to `config.env` in this directory (spot/config.env) and edit.
# Loaded by spot/app/main.py, spot_file_copy.py and spot_control.py, all of
# which resolve it as "../config.env" while running with spot/app as the
# working directory. Real config.env files are gitignored via *.env.

# ---------------------------------------------------------------------------
# Robot connection
# ---------------------------------------------------------------------------
# BRIDGE SPOT (serial spot-BD-13470009) on the BRIDGE-TRAINING network.
# This address is DHCP-assigned; check Admin Console > Network Setup if the
# robot stops responding. 192.168.80.3 is the robot's own access-point address,
# reachable only when connected directly to Spot's WiFi rather than the LAN.
SPOT_IP=192.168.33.137

# Credentials for the robot. Use a real Spot account -- these are the same
# username and password you use for the Admin Console. Never commit this file.
BOSDYN_CLIENT_USERNAME=awaiz
BOSDYN_CLIENT_PASSWORD=spot123456789

# Fiducial ID of the charging dock. Shown on the tablet when docked.
SPOT_DOCK_ID=520

# ---------------------------------------------------------------------------
# Control safety limits
# ---------------------------------------------------------------------------
# Server-side caps on joystick drive. The UI cannot exceed these regardless of
# what it sends. Raise deliberately and only with clear space around the robot.
SPOT_MAX_LINEAR_SPEED=0.6
SPOT_MAX_ANGULAR_SPEED=0.8

# How long a single velocity command stays valid, in seconds. Acts as a deadman:
# if the UI stops sending, the robot stops moving after this window.
SPOT_CMD_DURATION=0.6
