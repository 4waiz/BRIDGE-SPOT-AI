{
  "name": "bridge-spot-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start:spot": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_spot.ps1",
    "start:assistant": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_assistant.ps1",
    "start:frontend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start_frontend.ps1",
    "start": "concurrently -n spot,assistant,frontend -c \"blue,magenta,green\" \"npm run start:spot\" \"npm run start:assistant\" \"npm run start:frontend\""
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
